{
  "manifest_version": 3,
  "name": "Lingatu Connector — marcadores",
  "version": "1.2.1",
  "description": "Guarda marcadores: añade la pestaña activa a tu Lingatu local y, con el clic derecho, la selección como nota del enlace.",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "host_permissions": ["file:///*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Añadir a Lingatu",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}
