# Exportaciones de datos personales (enlaces reales del usuario)
lingatu_*.json
# El patrón anterior al cambio de nombre se mantiene: las exportaciones ya
# hechas siguen llamándose así y no deben acabar en el repositorio.
pinboard_*.json
marcadores_edge.json
marcadores_importados.json

# Configuración local de tools/convertir_marcadores.py (rutas de esta máquina)
tools/marcadores_config.json

# Configuración local de Claude Code (específica de esta máquina)
.claude/settings.local.json

# Notas privadas, no se publican
SYNC-NLEVIA-ORG.md

# Encargos de trabajo para Claude Code (instrucciones internas, no forman parte del producto)
encargos/

# Instrucciones locales de Claude Code (no forman parte del producto)
CLAUDE.md

# Sistema operativo / editores
.DS_Store
Thumbs.db

# Paquete generado para la Chrome Web Store (regenerable con tools/empaquetar_extension.py)
store/*.zip
